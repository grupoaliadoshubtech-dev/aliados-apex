# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
# Use the service_role key for backend operations
SUPABASE_KEY=your-supabase-service-role-key

# PostgreSQL Connection String for Worker (pg-boss)
# IMPORTANT: Use Session Pooler on port 5432 (not transaction pooler on 6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Symmetric Encryption Key for PFX passphrases (Exactly 32 characters)
ENCRYPTION_KEY=d7b5f12a893e4b0c7a6d9f8e5c3b2a10

# Web Server Port
PORT=3000
NODE_ENV=development

# Stripe Billing Configuration (Fase 2)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRICE_STARTER=price_1UCTw7EBcxLq17JueBxYoATY
STRIPE_PRICE_PRO=price_1UCTxrEBcxLq17JujuyLXxu5
STRIPE_PRICE_ADVANCED=price_1UCTzXEBcxLq17JudBVtyvSa

